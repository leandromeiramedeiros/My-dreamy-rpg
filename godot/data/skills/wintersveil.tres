template CT.buff {\"buff\":\"wintersveil\",\"t\":5,\"nova\":{\"r\":2.2,\"dmg\":40,\"hit\":{\"slow\":1}},\"col\":\"#bff4ff\",\"sfx\":\"frost\"}
