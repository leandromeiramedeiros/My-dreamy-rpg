cast: cast(p, a, tx, ty) {
    const [x, y] = ctAt(p, o, tx, ty);
    castAnim(p);
    zone(Object.assign({ x, y, col: o.col, follow: !!o.follow }, o.z));
    fx({ type: 'ring', x, y, r: o.z.r + 0.2, col: o.col, life: 0.4 }); sfx(o.sfx || 'arcane');
  }"
