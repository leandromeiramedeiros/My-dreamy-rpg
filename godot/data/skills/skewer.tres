cast: cast(p, a) {
      dashPlayer(p, Math.cos(a), Math.sin(a), 4.5, 0.25, { trail: '#e8f0ff', hit: { dmg: 260, r: 0.9, knock: 0.3 }, invuln: true, onEnd: () => {
