cast: cast(p, a, tx, ty) {
      castAnim(p); [tx, ty] = targetIn(p, tx, ty, 7);
      hitArea(tx, ty, 2.6, 60, { root: 2.5 }); fx({ type: 'marker', x: tx, y: ty, r: 2.6, col: '#c7e8ff', life: 1.2 }); sfx('arcane');
