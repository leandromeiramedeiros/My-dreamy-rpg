todo = "JS:
do: do(c, v, p) { if (c.el === 'arcane' && c.e.status && c.e.status.jolted && c.e.status.jolted.until > G.t) for (const k of ['q', 'e']) { const id = slotSkill(p, k); if (id && p.cds[id] > 0) p.cds[id] = Math.max(0, p.cds[id] - 2); } }"
