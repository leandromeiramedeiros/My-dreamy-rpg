"major": {
"potionCleanse": 2.0
},
"minor": {
"potionCleanse": 1.0
}
}
icd = 0.0
tags = PackedStringArray("potion")
todo = "Boon numbers: minor {\"potionCleanse\":1}, major {\"potionCleanse\":2}
JS:
do: do(c, v, p) { let n = v.potionCleanse || 1; for (const k of ['rootT', 'slowT', 'dreadT']) if (n > 0 && p[k] > 0) { p[k] = 0; n--; } }"
