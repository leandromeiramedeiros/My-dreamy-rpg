todo = "Boon numbers: minor {\"frostDmg\":0.08,\"freezeChance\":0.05}, major {\"frostDmg\":0.15,\"freezeChance\":0.1}
JS:
do: do(c, v) { if (c.el === 'frost' && Math.random() < (v.freezeChance || 0)) { const e = c.e; applyStatus(e, 'frozen', Math.max(e.stunT, e.boss ? 0.25 : 1), 'frost'); } }"
