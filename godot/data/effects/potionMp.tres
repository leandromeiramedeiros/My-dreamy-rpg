[gd_resource type="Resource" script_class="Effect" format=3]

[ext_resource type="Script" path="res://scripts/data/effect.gd" id="1_3pibp"]

[resource]
script = ExtResource("1_3pibp")
id = &"potionMp"
display_name = "Still Water"
hint = "Potions also restore 20% MP"
source = "trinket"
when_event = "potion"
if_tags = PackedStringArray()
do_action = &"potionMp"
do_params = {
"major": {
"potionMp": 0.2
},
"minor": {
"potionMp": 0.1
}
}
icd = 0.0
tags = PackedStringArray("potion", "mp")
todo = "Boon numbers: minor {\"potionMp\":0.1}, major {\"potionMp\":0.2}
JS:
do: do(c, v, p) { p.mp = Math.min(p.maxMp, p.mp + p.maxMp * (v.potionMp || 0)); }"
